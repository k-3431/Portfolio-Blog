---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <div class="notfound">
    <span class="notfound-code">404</span>
    <p class="notfound-text">這一頁不存在，或已經搬走了。</p>
    <a href="/" class="notfound-link">&larr; 返回首頁</a>
  </div>
</Base>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
  }

  .notfound-code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .notfound-text {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .notfound-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    transition: color 0.25s;
  }

  .notfound-link:hover {
    color: var(--fg);
  }
</style>
