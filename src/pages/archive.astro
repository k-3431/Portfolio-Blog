---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const years = [...new Set(posts.map((p) => new Date(p.data.date).getFullYear()))].sort((a, b) => b - a);
---

<Base title="目錄">
  <header class="page-header">
    <span class="page-label">archive</span>
    <h1 class="page-title">目錄</h1>
  </header>

  {years.map((year) => (
    <section class="year-section">
      <h2 class="year-title">{year}</h2>
      <div class="cat-list">
        {posts
          .filter((p) => new Date(p.data.date).getFullYear() === year)
          .map((post) => (
            <a href={`/posts/${post.id}`} class="archive-item">
              <time class="archive-date">{post.data.date}</time>
              <span class="archive-name">{post.data.title}</span>
              {post.data.category && <span class="archive-cat">{post.data.category}</span>}
            </a>
          ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .page-header {
    margin-bottom: 56px;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 300;
    color: var(--fg-faint);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 10px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .year-section {
    margin-bottom: 56px;
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 32px;
    align-items: start;
  }

  .year-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 400;
    font-style: italic;
    color: var(--fg);
    line-height: 1;
    letter-spacing: -0.02em;
    position: sticky;
    top: 40px;
  }

  .cat-list {
    border-top: 1px solid var(--border);
  }

  @media (max-width: 700px) {
    .year-section {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .year-title {
      position: static;
      font-size: 2rem;
    }
  }

  .cat-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .archive-item {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: color 0.2s, padding-left 0.3s;
  }

  .archive-item:hover {
    padding-left: 8px;
  }

  .archive-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    width: 70px;
  }

  .archive-name {
    font-size: 0.95rem;
    font-weight: 400;
    transition: color 0.2s;
  }

  .archive-item:hover .archive-name {
    color: var(--fg-muted);
  }

  .archive-cat {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-left: auto;
    flex-shrink: 0;
  }
</style>
