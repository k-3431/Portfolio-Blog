---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => p.data.category === '攝影')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Base title="攝影">
  <h1 class="page-title">攝影</h1>
  <div class="post-list">
    {posts.map((post) => (
      <a href={`/posts/${post.id}`} class="post-item">
        {post.data.image && (
          <div class="post-thumb">
            <img src={post.data.image} alt={post.data.title} loading="lazy" />
          </div>
        )}
        <div class="post-info">
          <time class="post-date">{post.data.date}</time>
          <h2 class="post-name">{post.data.title}</h2>
          {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 40px;
    letter-spacing: -0.01em;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: background 0.2s;
  }

  .post-item:first-child {
    border-top: 1px solid var(--border);
  }

  .post-item:hover {
    background: var(--card-bg);
    margin: 0 -16px;
    padding: 24px 16px;
  }

  .post-thumb {
    overflow: hidden;
    border-radius: 3px;
    width: 180px;
    height: 120px;
    flex-shrink: 0;
    
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .post-thumb img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 300;
    color: var(--fg-faint);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 6px;
  }

  .post-name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .post-excerpt {
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .post-item {
      grid-template-columns: 1fr;
    }

    .post-thumb img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
