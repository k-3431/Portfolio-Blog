---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="kk">
  <div class="masonry" id="masonry">
    {posts.map((post) => (
      <article class="card">
        <a href={`/posts/${post.id}`} class="card-inner">
          {post.data.image ? (
            <div class="card-image">
              <img src={post.data.image} alt={post.data.title} loading="lazy" />
            </div>
          ) : (
            <div class="card-noimage">
              <span>✳ {post.data.category || 'post'}</span>
            </div>
          )}
          <div class="card-body">
            <h2 class="card-title">{post.data.title}</h2>
            {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="card-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="card-tag">{tag}</span>
                ))}
              </div>
            )}
            <div class="card-meta">
              <time class="card-date">{post.data.date}</time>
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
  <div class="page-end"></div>
</Base>

<style>
  .masonry {
    position: relative;
  }

  .card {
    position: absolute;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.25, 0.1, 0, 1);
    transition-delay: var(--reveal-delay, 0s);
  }

  .card.placed {
    opacity: 1;
    transform: translateY(0);
  }

  .card-inner {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
    text-decoration: none;
    color: var(--fg);
    transition: transform 0.35s cubic-bezier(0.25, 0.1, 0, 1), border-color 0.3s, box-shadow 0.35s;
  }

  .card-inner:hover {
    transform: translateY(-4px);
    border-color: #999;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
  }

  .card-noimage {
    padding: 28px 22px 0;
  }

  .card-noimage span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--fg-faint);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: inline-block;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .card-image {
    overflow: hidden;
    position: relative;
  }

  .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.03));
    pointer-events: none;
  }

  .card-image img {
    width: 100%;
    display: block;
  }

  .card-body {
    padding: 20px 22px 22px;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.6;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
    transition: color 0.3s;
  }

  .card-inner:hover .card-title {
    color: var(--fg-muted);
  }

  .card-excerpt {
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--fg-faint);
    letter-spacing: 0.1em;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin-bottom: 12px;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--fg-faint);
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 2px;
    line-height: 1.6;
  }

  .page-end {
    height: 80px;
  }
</style>

<script>
  let firstLayout = true;

  function layoutMasonry() {
    const container = document.getElementById('masonry');
    if (!container) return;

    const cards = Array.from(container.querySelectorAll('.card')) as HTMLElement[];
    const gap = 24;
    const containerWidth = container.offsetWidth;

    let cols = 3;
    if (containerWidth < 600) cols = 1;
    else if (containerWidth < 1024) cols = 2;

    const colWidth = (containerWidth - gap * (cols - 1)) / cols;
    const colHeights = new Array(cols).fill(0);

    cards.forEach((card, i) => {
      card.style.width = `${colWidth}px`;

      // Find shortest column
      const minHeight = Math.min(...colHeights);
      const colIndex = colHeights.indexOf(minHeight);

      const x = colIndex * (colWidth + gap);
      const y = minHeight;

      card.style.left = `${x}px`;
      card.style.top = `${y}px`;

      if (firstLayout) {
        card.style.setProperty('--reveal-delay', `${i * 0.06}s`);
      }
      card.classList.add('placed');

      colHeights[colIndex] = y + card.offsetHeight + gap;
    });

    container.style.height = `${Math.max(...colHeights)}px`;

    if (firstLayout) {
      firstLayout = false;
      // 進場結束後清掉 delay，避免之後 relayout 被延遲
      setTimeout(() => {
        cards.forEach((card) => card.style.removeProperty('--reveal-delay'));
      }, cards.length * 60 + 700);
    }
  }

  // 立即排版一次，之後每張圖載入完成再重排（debounced），
  // 避免 lazy 圖片晚到造成卡片重疊
  let relayoutTimer: ReturnType<typeof setTimeout> | undefined;
  function scheduleRelayout() {
    clearTimeout(relayoutTimer);
    relayoutTimer = setTimeout(layoutMasonry, 80);
  }

  function initMasonry() {
    layoutMasonry();
    document.querySelectorAll('.card-image img').forEach((img) => {
      if (!(img as HTMLImageElement).complete) {
        img.addEventListener('load', scheduleRelayout);
        img.addEventListener('error', scheduleRelayout);
      }
    });
  }

  initMasonry();
  window.addEventListener('resize', scheduleRelayout);
</script>
