---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const base = import.meta.env.BASE_URL;
---

<Base title="K.">
  <div class="masonry" id="masonry">
    {posts.map((post) => (
      <article class="card">
        <a href={`${base}/posts/${post.id}`} class="card-inner">
          {post.data.image && (
            <div class="card-image">
              <img src={`${base}${post.data.image}`} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="card-body">
            <h2 class="card-title">{post.data.title}</h2>
            {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt}</p>}
            <time class="card-date">{post.data.date}</time>
          </div>
        </a>
      </article>
    ))}
  </div>
  <div class="page-end"></div>
</Base>

<style>
  .masonry {
    position: relative;
  }

  .card {
    position: absolute;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.3s ease;
  }

  .card.placed {
    opacity: 1;
  }

  .card-inner {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    color: var(--fg);
    transition: transform 0.3s ease, border-color 0.3s, box-shadow 0.3s;
  }

  .card-inner:hover {
    transform: scale(1.03);
    border-color: #999;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
  }

  .card-image {
    overflow: hidden;
    position: relative;
  }

  .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.03));
    pointer-events: none;
  }

  .card-image img {
    width: 100%;
    display: block;
  }

  .card-body {
    padding: 20px 22px 22px;
  }

  .card-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.6;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
    transition: color 0.3s;
  }

  .card-inner:hover .card-title {
    color: var(--fg-muted);
  }

  .card-excerpt {
    font-size: 0.82rem;
    color: var(--fg-muted);
    line-height: 1.75;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--fg-faint);
    letter-spacing: 0.1em;
    display: block;
  }

  .page-end {
    height: 80px;
  }
</style>

<script>
  function layoutMasonry() {
    const container = document.getElementById('masonry');
    if (!container) return;

    const cards = Array.from(container.querySelectorAll('.card')) as HTMLElement[];
    const gap = 24;
    const containerWidth = container.offsetWidth;

    let cols = 3;
    if (containerWidth < 600) cols = 1;
    else if (containerWidth < 1024) cols = 2;

    const colWidth = (containerWidth - gap * (cols - 1)) / cols;
    const colHeights = new Array(cols).fill(0);

    cards.forEach((card) => {
      card.style.width = `${colWidth}px`;

      // Find shortest column
      const minHeight = Math.min(...colHeights);
      const colIndex = colHeights.indexOf(minHeight);

      const x = colIndex * (colWidth + gap);
      const y = minHeight;

      card.style.left = `${x}px`;
      card.style.top = `${y}px`;
      card.classList.add('placed');

      colHeights[colIndex] = y + card.offsetHeight + gap;
    });

    container.style.height = `${Math.max(...colHeights)}px`;
  }

  // Wait for images to load then layout
  function initMasonry() {
    const images = document.querySelectorAll('.card-image img');
    let loaded = 0;
    const total = images.length;

    if (total === 0) {
      layoutMasonry();
      return;
    }

    images.forEach((img) => {
      if ((img as HTMLImageElement).complete) {
        loaded++;
        if (loaded === total) layoutMasonry();
      } else {
        img.addEventListener('load', () => {
          loaded++;
          if (loaded === total) layoutMasonry();
        });
        img.addEventListener('error', () => {
          loaded++;
          if (loaded === total) layoutMasonry();
        });
      }
    });

    // Fallback
    setTimeout(layoutMasonry, 3000);
  }

  initMasonry();
  window.addEventListener('resize', layoutMasonry);
</script>
